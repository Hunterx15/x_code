# ===========================================================================
# XCode Backend Environment Variables
# ===========================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
#
# SECURITY NOTE: the previous .env file in this repository contained REAL
# production secrets (MongoDB Atlas password, Redis password, Cloudinary
# secret, Judge0 API key, Gemini API key, JWT signing key). Those secrets
# MUST be rotated immediately — anyone with access to the repo history has
# them. This .env.example contains only placeholder values.
# ===========================================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Frontend Origin ---
# The URL where the frontend is served. Used for CORS, Google OAuth redirect,
# and Helmet CSP.
CLIENT_URL=http://localhost:5173

# --- Database ---
# MongoDB connection string. Replace with your own Atlas or self-hosted URL.
DB_CONNECT_STRING=mongodb://localhost:27017/xcode

# --- Redis ---
# Redis instance for the JWT token blocklist (used on logout).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=

# --- JWT ---
# HMAC secret used to sign JWT auth tokens. Generate with:
#   openssl rand -hex 32
JWT_KEY=replace-with-a-long-random-hex-string

# --- Cloudinary ---
# Used for video editorial uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Judge0 (Code Execution) ---
# RapidAPI key for the Judge0 CE API.
JUDGE0_KEY=your-rapidapi-key

# --- Google GenAI (AI Chat Tutor) ---
# API key for Google Gemini.
GEMINI_KEY=your-gemini-api-key

# --- Cookie Policy ---
# Local dev (HTTP):       COOKIE_SECURE=false  COOKIE_SAMESITE=lax
# Production (HTTPS):     COOKIE_SECURE=true   COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_MAX_AGE=3600000

# --- Google OAuth (optional) ---
# Only required if you want Google sign-in. Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/user/auth/google/callback

# --- Rate Limiting ---
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_OAUTH_WINDOW_MS=900000
RATE_LIMIT_OAUTH_MAX=10
RATE_LIMIT_AI_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=20

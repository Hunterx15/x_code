# ===========================================================================
# 14Dev Frontend Environment Variables
# ===========================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
#
# This file was auto-generated by scanning every import.meta.env reference
# in frontend/src/. Vite inlines env vars at build time, so this file
# must be present BEFORE running `npm run build`.
# ===========================================================================

# Backend API base URL.
# Used by:
#   - axiosClient (all API requests)
#   - Login/Signup pages (the "Continue with Google" button links to
#     ${VITE_API_URL}/user/auth/google)
# After OAuth completes, the backend redirects to the frontend's
# /auth/google/success route, which hydrates Redux via /user/check.
VITE_API_URL=http://localhost:3000
